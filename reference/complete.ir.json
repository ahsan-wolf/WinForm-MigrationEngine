          {
            "Id": "SqlDataSource1",
            "TagName": "asp:SqlDataSource",
            "Attributes": {
              "ID": "SqlDataSource1",
              "Runat": "server",
              "SelectCommand": "SELECT ac.ActorID, c.CountyName, ac.StateCode, ac.ActorCountyID, a.DisplayName AS ActorName, s.StateName\r\n      FROM dbo.aa_ActorCounties AS ac INNER JOIN\r\n      dbo.aa_Actors AS a ON ac.ActorID = a.ActorID INNER JOIN\r\n      dbo.al_States AS s ON ac.StateCode = s.StateCode LEFT OUTER JOIN\r\n      dbo.al_Counties AS c ON ac.StateCode = c.StateCode AND ac.CountyCode = c.CountyCode",
              "ConnectionString": "\u003C%$ ConnectionStrings:SODB %\u003E"
            },
            "Children": [],
