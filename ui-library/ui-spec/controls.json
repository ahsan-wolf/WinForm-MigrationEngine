      "a11y": "native select with size (listbox role); arrow keys change the selection.", "example": "<WfListBox items={['A','B']} value={sel} onSelectionChange={setSel} />" },
    { "name": "WfTreeView", "winformsTypes": ["System.Windows.Forms.TreeView"],
      "props": [
        { "name": "nodes", "type": "WfTreeNode[]", "note": "Page model: vm.<id>.nodes. Each node: text, name, tag, checked, expanded, nodes[]. Nodes.Add / new TreeNode / node.Nodes translate onto this array." },
        { "name": "selectedNode", "type": "WfTreeNode | null", "note": "Page model: vm.<id>.selectedNode (WinForms SelectedNode)." },
        { "name": "checkBoxes", "type": "boolean", "from": ["CheckBoxes"], "transform": "bool" },
        { "name": "disabled", "type": "boolean", "from": ["Enabled"], "transform": "invert" } ],
      "events": [
        { "name": "selectionChange", "from": "AfterSelect", "react": "onSelectionChange" },
        { "name": "nodeCheckedChange", "from": "AfterCheck", "react": "onNodeCheckedChange" },
        { "name": "nodeClick", "from": "NodeMouseClick", "react": "onNodeClick" },
        { "name": "nodeDoubleClick", "from": "NodeMouseDoubleClick", "react": "onNodeDoubleClick" } ],
