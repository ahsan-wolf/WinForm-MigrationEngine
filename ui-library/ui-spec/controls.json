      "example": "<WfTreeView nodes={vm.tv.nodes} selectedNode={vm.tv.selectedNode} onSelectionChange={n => { vm.tv.selectedNode = n; }} />" },
    { "name": "WfCheckedListBox", "winformsTypes": ["System.Windows.Forms.CheckedListBox"],
      "props": [
        { "name": "items", "type": "string[]", "from": ["Items"], "note": "JSON string array in the IR attribute `Items`; page model keeps `items` (same model as a ComboBox)." },
        { "name": "checkedIndices", "type": "number[]", "from": ["CheckedIndices"], "note": "Page model: vm.<id>.checkedIndices. CheckedItems / GetItemChecked / SetItemChecked translate onto it." },
        { "name": "value", "type": "string", "from": ["Text"] },
