{
  "specVersion": "0.1.0",
  "note": "Framework-neutral control contract. Every ui-library package implements these names, props and canonical events. Generators read this file as data: `winformsTypes` picks the component, `props[].from` maps WinForms properties, `events[].from` maps WinForms events, `childOf`/`slot` place designer children. Additive changes only; a breaking change needs a major bump and a note in docs/.",
  "transforms": {
    "mnemonic": "Text 'E&xit' -> text 'Exit' + accessKey 'x' (the library renders the underline)",
    "invert": "WinForms Enabled=false -> disabled=true",
    "bool": "'true'/'false' string -> boolean",
    "int": "numeric string -> number"
  },
  "controls": [
    { "name": "WfForm", "winformsTypes": ["System.Windows.Forms.Form"], "container": true,
      "props": [
        { "name": "title", "type": "string", "from": ["Text"] },
        { "name": "acceptButtonId", "type": "string", "from": ["AcceptButton"] },
        { "name": "cancelButtonId", "type": "string", "from": ["CancelButton"] } ],
      "events": [ { "name": "load", "from": "Load", "react": "onLoad" } ],
      "a11y": "Renders a landscape region labelled by title; Enter/Escape click the accept/cancel button by id.",
      "example": "<WfForm title=\"Navigator\" onLoad={handleLoad}>…</WfForm>" },

    { "name": "WfMenuBar", "winformsTypes": ["System.Windows.Forms.MenuStrip"], "container": true,
      "props": [], "events": [],
      "a11y": "role=menubar; children are WfMenuItem / WfSeparator; arrow-free hover/click model in 0.1.",
      "example": "<WfMenuBar><WfMenuItem text=\"&File\">…</WfMenuItem></WfMenuBar>" },
    { "name": "WfMenuItem", "winformsTypes": ["System.Windows.Forms.ToolStripMenuItem"], "container": true,
      "props": [
        { "name": "text", "type": "string", "from": ["Text"], "transform": "mnemonic" },
        { "name": "shortcut", "type": "string", "from": ["ShortcutKeyDisplayString", "ShortcutKeys"] },
        { "name": "checked", "type": "boolean", "from": ["Checked"], "transform": "bool" },
        { "name": "disabled", "type": "boolean", "from": ["Enabled"], "transform": "invert" } ],
      "events": [ { "name": "click", "from": "Click", "react": "onClick" } ],
      "a11y": "role=menuitem; aria-haspopup/expanded when it has children; accessKey from the & mnemonic.",
      "example": "<WfMenuItem text=\"E&xit\" shortcut=\"Alt+F4\" onClick={handleExit} />" },
    { "name": "WfSeparator", "winformsTypes": ["System.Windows.Forms.ToolStripSeparator"],
      "props": [], "events": [], "a11y": "role=separator.", "example": "<WfSeparator />" },

    { "name": "WfToolbar", "winformsTypes": ["System.Windows.Forms.ToolStrip"], "container": true,
      "props": [], "events": [], "a11y": "role=toolbar.", "example": "<WfToolbar><WfToolbarButton tooltip=\"Browse\" /></WfToolbar>" },
    { "name": "WfToolbarButton", "winformsTypes": ["System.Windows.Forms.ToolStripButton"],
      "props": [
        { "name": "text", "type": "string", "from": ["Text"], "transform": "mnemonic" },
        { "name": "tooltip", "type": "string", "from": ["ToolTipText"] },
        { "name": "icon", "type": "string", "from": ["Image"], "note": "Designer images live in .resx; the generator does not extract them in 0.1." },
        { "name": "disabled", "type": "boolean", "from": ["Enabled"], "transform": "invert" } ],
      "events": [ { "name": "click", "from": "Click", "react": "onClick" } ],
      "a11y": "button with aria-label = tooltip or text.", "example": "<WfToolbarButton tooltip=\"Add Files\" onClick={handleAdd} />" },
    { "name": "WfStatusBar", "winformsTypes": ["System.Windows.Forms.StatusStrip"], "container": true,
      "props": [], "events": [], "a11y": "role=status.", "example": "<WfStatusBar>Ready</WfStatusBar>" },

    { "name": "WfPanel", "winformsTypes": ["System.Windows.Forms.Panel", "System.Windows.Forms.FlowLayoutPanel"], "container": true,
      "props": [ { "name": "visible", "type": "boolean", "from": ["Visible"], "transform": "bool" } ],
      "events": [], "a11y": "Plain region; hidden panels are not rendered.", "example": "<WfPanel visible>…</WfPanel>" },
    { "name": "WfGroupBox", "winformsTypes": ["System.Windows.Forms.GroupBox"], "container": true,
      "props": [
        { "name": "title", "type": "string", "from": ["Text"] },
        { "name": "visible", "type": "boolean", "from": ["Visible"], "transform": "bool" },
        { "name": "disabled", "type": "boolean", "from": ["Enabled"], "transform": "invert" } ],
      "events": [], "a11y": "fieldset with a legend; disabled disables all descendants.", "example": "<WfGroupBox title='Options'>…</WfGroupBox>" },
    { "name": "WfSplit", "winformsTypes": ["System.Windows.Forms.SplitContainer"], "container": true,
      "slots": ["Panel1", "Panel2"],
      "props": [
        { "name": "orientation", "type": "enum:horizontal|vertical", "from": ["Orientation"] },
        { "name": "splitterDistance", "type": "number", "from": ["SplitterDistance"], "transform": "int" } ],
      "events": [], "a11y": "role=group; two WfSplitPane children.", "example": "<WfSplit><WfSplitPane>…</WfSplitPane><WfSplitPane>…</WfSplitPane></WfSplit>" },
    { "name": "WfSplitPane", "winformsTypes": [], "container": true, "props": [], "events": [],
      "a11y": "Pane of a WfSplit; generated from the ParentSlot Panel1/Panel2 grouping.", "example": "<WfSplitPane>…</WfSplitPane>" },

    { "name": "WfLabel", "winformsTypes": ["System.Windows.Forms.Label", "System.Windows.Forms.ToolStripLabel", "System.Windows.Forms.ToolStripStatusLabel"],
      "props": [ { "name": "text", "type": "string", "from": ["Text"], "transform": "mnemonic" } ], "events": [],
      "a11y": "span; use htmlFor to bind to an input.", "example": "<WfLabel text=\"Name:\" />" },
    { "name": "WfButton", "winformsTypes": ["System.Windows.Forms.Button"],
      "props": [
        { "name": "text", "type": "string", "from": ["Text"], "transform": "mnemonic" },
        { "name": "disabled", "type": "boolean", "from": ["Enabled"], "transform": "invert" } ],
      "events": [ { "name": "click", "from": "Click", "react": "onClick" } ],
      "a11y": "button; accessKey from the & mnemonic.", "example": "<WfButton text=\"&Save\" onClick={handleSave} />" },
    { "name": "WfTextBox", "winformsTypes": ["System.Windows.Forms.TextBox"],
      "props": [
        { "name": "value", "type": "string", "from": ["Text"] },
        { "name": "readOnly", "type": "boolean", "from": ["ReadOnly"], "transform": "bool" },
        { "name": "maxLength", "type": "number", "from": ["MaxLength"], "transform": "int" },
        { "name": "multiline", "type": "boolean", "from": ["Multiline"], "transform": "bool" },
        { "name": "password", "type": "boolean", "from": ["UseSystemPasswordChar"], "transform": "bool" } ],
      "events": [ { "name": "valueChange", "from": "TextChanged", "react": "onValueChange" } ],
      "a11y": "input/textarea; label via aria-label or htmlFor.", "example": "<WfTextBox value={name} onValueChange={setName} />" },
    { "name": "WfComboBox", "winformsTypes": ["System.Windows.Forms.ComboBox", "System.Windows.Forms.ToolStripComboBox"],
      "props": [ { "name": "items", "type": "string[]", "from": ["Items"], "note": "JSON string array in the IR attribute `Items`." },
                 { "name": "value", "type": "string", "from": ["Text"] },
                 { "name": "disabled", "type": "boolean", "from": ["Enabled"], "transform": "invert" } ],
      "events": [ { "name": "selectionChange", "from": "SelectedIndexChanged", "react": "onSelectionChange" } ],
      "a11y": "native select.", "example": "<WfComboBox items={['A','B']} onSelectionChange={setValue} />" },
    { "name": "WfCheckBox", "winformsTypes": ["System.Windows.Forms.CheckBox"],
      "props": [ { "name": "text", "type": "string", "from": ["Text"], "transform": "mnemonic" },
                 { "name": "checked", "type": "boolean", "from": ["Checked"], "transform": "bool" } ],
      "events": [ { "name": "checkedChange", "from": "CheckedChanged", "react": "onCheckedChange" } ],
      "a11y": "native checkbox with label.", "example": "<WfCheckBox text=\"Recurse\" checked={on} onCheckedChange={setOn} />" },
    { "name": "WfDateTimePicker", "winformsTypes": ["System.Windows.Forms.DateTimePicker"],
      "props": [
        { "name": "value", "type": "string", "from": ["Value"], "note": "ISO text. Page model: vm.<id>.value." },
        { "name": "kind", "type": "enum:date|datetime|time", "note": "From Format / CustomFormat (the generator reads them; no direct from)." },
        { "name": "disabled", "type": "boolean", "from": ["Enabled"], "transform": "invert" } ],
      "events": [ { "name": "valueChange", "from": "ValueChanged", "react": "onValueChange" } ],
      "a11y": "native date / datetime-local / time input.", "example": "<WfDateTimePicker value={d} onValueChange={setD} />" },
    { "name": "WfRadioButton", "winformsTypes": ["System.Windows.Forms.RadioButton"],
      "props": [
        { "name": "text", "type": "string", "from": ["Text"], "transform": "mnemonic" },
        { "name": "checked", "type": "boolean", "from": ["Checked"], "transform": "bool" },
        { "name": "group", "type": "string", "note": "Set by the generator to the id of the parent container: radio buttons of one container are mutually exclusive." },
        { "name": "disabled", "type": "boolean", "from": ["Enabled"], "transform": "invert" } ],
      "events": [ { "name": "checkedChange", "from": "CheckedChanged", "react": "onCheckedChange" } ],
      "a11y": "native radio input with label and a shared name per group.", "example": "<WfRadioButton text=\"A\" group=\"g\" checked={on} onCheckedChange={set} />" },
    { "name": "WfNumericUpDown", "winformsTypes": ["System.Windows.Forms.NumericUpDown"],
      "props": [
        { "name": "value", "type": "number", "from": ["Value"] },
        { "name": "min", "type": "number", "from": ["Minimum"], "transform": "int" },
        { "name": "max", "type": "number", "from": ["Maximum"], "transform": "int" },
        { "name": "step", "type": "number", "from": ["Increment"], "transform": "int" },
        { "name": "decimals", "type": "number", "from": ["DecimalPlaces"], "transform": "int" },
        { "name": "readOnly", "type": "boolean", "from": ["ReadOnly"], "transform": "bool" },
        { "name": "disabled", "type": "boolean", "from": ["Enabled"], "transform": "invert" } ],
      "events": [ { "name": "valueChange", "from": "ValueChanged", "react": "onValueChange" } ],
      "a11y": "native number input.", "example": "<WfNumericUpDown value={n} min={0} max={10} onValueChange={setN} />" },
    { "name": "WfLinkLabel", "winformsTypes": ["System.Windows.Forms.LinkLabel"],
      "props": [
        { "name": "text", "type": "string", "from": ["Text"], "transform": "mnemonic" },
        { "name": "disabled", "type": "boolean", "from": ["Enabled"], "transform": "invert" } ],
      "events": [ { "name": "click", "from": "LinkClicked", "react": "onClick" }, { "name": "click", "from": "Click", "react": "onClick" } ],
      "a11y": "anchor with role=link; keyboard reachable.", "example": "<WfLinkLabel text=\"Forgot password?\" onClick={open} />" },
    { "name": "WfTabs", "winformsTypes": ["System.Windows.Forms.TabControl"], "container": true, "slots": ["TabPages"],
      "props": [ { "name": "selectedIndex", "type": "number", "from": ["SelectedIndex"], "transform": "int" } ],
      "events": [ { "name": "selectionChange", "from": "SelectedIndexChanged", "react": "onSelectionChange" } ],
      "a11y": "tablist/tab/tabpanel roles; arrow keys, Home/End move between tabs; every page stays mounted.", "example": "<WfTabs><WfTabPage title=\"General\">…</WfTabPage></WfTabs>" },
    { "name": "WfTabPage", "winformsTypes": ["System.Windows.Forms.TabPage"], "container": true,
      "props": [ { "name": "title", "type": "string", "from": ["Text"] } ],
      "events": [], "a11y": "tabpanel content of a WfTabs.", "example": "<WfTabPage title=\"General\">…</WfTabPage>" },
    { "name": "WfProgress", "winformsTypes": ["System.Windows.Forms.ProgressBar", "System.Windows.Forms.ToolStripProgressBar"],
      "props": [ { "name": "value", "type": "number", "from": ["Value"], "transform": "int" },
                 { "name": "max", "type": "number", "from": ["Maximum"], "transform": "int" } ],
      "events": [], "a11y": "role=progressbar with aria-valuenow/max.", "example": "<WfProgress value={40} max={100} />" },
    { "name": "WfPictureBox", "winformsTypes": ["System.Windows.Forms.PictureBox"],
      "props": [ { "name": "src", "type": "string", "from": ["ImageLocation"] },
                 { "name": "fit", "type": "enum:contain|fill|none|cover", "from": ["SizeMode"] } ],
      "events": [ { "name": "click", "from": "Click", "react": "onClick" } ],
      "a11y": "img; provide alt.", "example": "<WfPictureBox src=\"/logo.png\" alt=\"Logo\" />" },

    { "name": "WfDataGrid", "winformsTypes": ["System.Windows.Forms.DataGridView"], "container": true,
      "props": [
        { "name": "rows", "type": "Row[]" },
        { "name": "columns", "type": "WfGridColumn[]", "note": "Built from child column nodes: HeaderText -> header, DataPropertyName -> field, Width -> width, DefaultCellStyle.Format -> format." },
        { "name": "selectionMode", "type": "enum:none|single|multi", "from": ["MultiSelect"] },
        { "name": "readOnly", "type": "boolean", "from": ["ReadOnly"], "transform": "bool" } ],
      "events": [ { "name": "rowSelect", "from": "SelectionChanged", "react": "onRowSelect" },
                  { "name": "cellClick", "from": "CellClick", "react": "onCellClick" },
                  { "name": "cellClick", "from": "CellContentClick", "react": "onCellClick" },
                  { "name": "cellClick", "from": "CellMouseClick", "react": "onCellClick" } ],
      "a11y": "table with row selection via click and aria-selected.", "example": "<WfDataGrid rows={rows} columns={cols} onRowSelect={handle} />" },
    { "name": "WfListView", "winformsTypes": ["System.Windows.Forms.ListView"], "container": true,
      "props": [
        { "name": "columns", "type": "WfListColumn[]", "note": "Built from child ColumnHeader nodes (Text -> header, Width -> width); kept in the page model so code can Columns.Add/Clear." },
        { "name": "items", "type": "WfListItem[]", "note": "Page model: vm.<id>.items. Each item: text, subItems[], checked, selected, tag. SelectedItems is a filter over `selected`." },
        { "name": "checkBoxes", "type": "boolean", "from": ["CheckBoxes"], "transform": "bool" },
        { "name": "multiSelect", "type": "boolean", "note": "Defaults to true (WinForms default); the generator passes false only when the designer sets MultiSelect=false." },
        { "name": "disabled", "type": "boolean", "from": ["Enabled"], "transform": "invert" } ],
      "events": [
        { "name": "selectionChange", "from": "SelectedIndexChanged", "react": "onSelectionChange" },
        { "name": "itemCheckedChange", "from": "ItemChecked", "react": "onItemCheckedChange" },
        { "name": "itemActivate", "from": "ItemActivate", "react": "onItemActivate" },
        { "name": "click", "from": "MouseClick", "react": "onClick" },
        { "name": "doubleClick", "from": "DoubleClick", "react": "onDoubleClick" },
        { "name": "keyUp", "from": "KeyUp", "react": "onKeyUp" },
        { "name": "columnClick", "from": "ColumnClick", "react": "onColumnClick" } ],
      "a11y": "role=grid, aria-multiselectable; rows aria-selected; arrow keys move the selection, Enter activates, Ctrl+A selects all, Ctrl/Shift click extends it.",
      "example": "<WfListView columns={cols} items={vm.lv.items} onSelectionChange={sel => { vm.lv.items.forEach((it, i) => { it.selected = sel.includes(i); }); }} />" },
    { "name": "WfMaskedTextBox", "winformsTypes": ["System.Windows.Forms.MaskedTextBox"],
      "props": [
        { "name": "value", "type": "string", "from": ["Text"] },
        { "name": "mask", "type": "string", "from": ["Mask"], "note": "WinForms mask: 0 digit, 9 optional digit, # digit/sign, L/? letter, A/a letter or digit, &/C any, backslash escapes the next character, other characters are literals." },
        { "name": "readOnly", "type": "boolean", "from": ["ReadOnly"], "transform": "bool" },
        { "name": "disabled", "type": "boolean", "from": ["Enabled"], "transform": "invert" } ],
      "events": [ { "name": "valueChange", "from": "TextChanged", "react": "onValueChange" } ],
      "a11y": "native text input; the mask is shown as a placeholder.", "example": "<WfMaskedTextBox mask=\"(000) 000-0000\" value={phone} onValueChange={setPhone} />" },
    { "name": "WfRichTextBox", "winformsTypes": ["System.Windows.Forms.RichTextBox"],
      "props": [
        { "name": "value", "type": "string", "from": ["Text"] },
        { "name": "readOnly", "type": "boolean", "from": ["ReadOnly"], "transform": "bool" },
        { "name": "disabled", "type": "boolean", "from": ["Enabled"], "transform": "invert" } ],
      "events": [ { "name": "valueChange", "from": "TextChanged", "react": "onValueChange" } ],
      "a11y": "native textarea. Plain text only: character formatting of the original is not reproduced.", "example": "<WfRichTextBox value={notes} onValueChange={setNotes} />" },
    { "name": "WfMonthCalendar", "winformsTypes": ["System.Windows.Forms.MonthCalendar"],
      "props": [
        { "name": "value", "type": "string", "from": ["SelectionStart"], "note": "ISO date text (page model key selectionStart)." },
        { "name": "disabled", "type": "boolean", "from": ["Enabled"], "transform": "invert" } ],
      "events": [ { "name": "valueChange", "from": "DateChanged", "react": "onValueChange" }, { "name": "valueChange", "from": "DateSelected", "react": "onValueChange" } ],
      "a11y": "role=group with a grid of day buttons; previous/next month buttons.", "example": "<WfMonthCalendar value={day} onValueChange={setDay} />" },
    { "name": "WfListBox", "winformsTypes": ["System.Windows.Forms.ListBox"],
      "props": [
        { "name": "items", "type": "string[]", "from": ["Items"], "note": "JSON string array in the IR attribute `Items`; with code that touches Items/SelectedIndex/SelectedItem the page model keeps them (same model as a ComboBox)." },
        { "name": "value", "type": "string", "from": ["Text"] },
        { "name": "disabled", "type": "boolean", "from": ["Enabled"], "transform": "invert" } ],
