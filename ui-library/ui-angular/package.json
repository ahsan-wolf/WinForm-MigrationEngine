{
  "name": "@wfm/ui-angular",
  "version": "0.4.0",
  "description": "Angular 21 (standalone components) implementation of @wfm/ui-spec. Independent of the migration engine and of any IR. Consumed as TypeScript source (tsconfig path) by generated apps.",
  "type": "module",
  "private": true,
  "main": "./src/public-api.ts",
  "types": "./src/public-api.ts",
  "files": [
    "src"
  ],
  "peerDependencies": {
    "@angular/core": "^21.0.0",
    "@angular/common": "^21.0.0"
  },
  "scripts": {
    "build": "node ./node_modules/@angular/compiler-cli/bundles/src/bin/ngc.js -p tsconfig.json --noEmit",
    "lint": "node ./node_modules/eslint/bin/eslint.js ."
  },
  "devDependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/compiler-cli": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "rxjs": "^7.8.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.1"
  }
}
