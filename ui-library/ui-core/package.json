{
  "name": "@wfm/ui-core",
  "version": "0.5.0",
  "description": "Framework-free helpers and types shared by the @wfm/ui-* packages (grid model, image list, tree nodes, list items, mnemonics). Independent of the migration engine and of any IR.",
  "type": "module",
  "private": true,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" }, "./wf.css": "./dist/wf.css" },
  "files": ["dist"],
  "sideEffects": ["*.css"],
  "scripts": {
    "build": "node ./node_modules/typescript/bin/tsc -p tsconfig.json && node -e \"require('fs').copyFileSync('src/wf.css', 'dist/wf.css')\"",
    "lint": "node ./node_modules/eslint/bin/eslint.js ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1"
  }
}
