{
  "name": "@wfm/ui-core",
  "version": "0.3.0",
  "description": "Framework-free helpers and types shared by the @wfm/ui-* packages (grid model, image list, tree nodes, list items, mnemonics). Independent of the migration engine and of any IR.",
  "type": "module",
  "private": true,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "build": "node ./node_modules/typescript/bin/tsc -p tsconfig.json",
    "lint": "node ./node_modules/eslint/bin/eslint.js ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1"
  }
}
