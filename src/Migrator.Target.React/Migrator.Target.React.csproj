<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Migrator.Target.React</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Contracts only. Targets never reference a source engine; they read the IR files. -->
    <ProjectReference Include="..\Migrator.Engine\Migrator.Engine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Same version as WebFormsMigrator.IR.Contracts so the two never diverge. Used to parse C# method bodies for translation. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />
  </ItemGroup>

  <Import Project="$(MSBuildThisFileDirectory)..\..\build\IrReference.props" />

</Project>
