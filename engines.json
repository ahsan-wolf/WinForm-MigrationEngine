{
  // Authoritative allow-list of engines. Nothing loads unless it is listed here and enabled.
  // "assembly": built-in engines are found in the app directory; anything else in plugins/<assembly>.dll
  // or plugins/<assembly>/<assembly>.dll. "options" is passed to the module's (EngineOptions) constructor.
  "pluginsDirectory": "plugins",
  "engines": [
    { "id": "winforms", "enabled": true, "assembly": "Migrator.Source.WinForms", "options": {} },
    { "id": "react-app", "enabled": true, "assembly": "Migrator.Target.React",
      "options": { "uiSpecPath": "ui-library/ui-spec/controls.json", "uiLibraryPath": "ui-library/ui-react" } }
  ]
}
